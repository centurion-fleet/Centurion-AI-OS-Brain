[Unit]
Description=Centurion encrypted iPhone service (away-from-home TCP 9119)
Documentation=https://github.com/centurion-fleet/Centurion-AI-OS
After=network-online.target
Wants=network-online.target
# Bound the crash loop. Restart=on-failure + RestartSec=3 below means a start
# that cannot bind the port retries every three seconds forever — measured in
# the field at 672 failed starts. After five attempts in a minute systemd gives
# up and leaves the unit failed, which is a state somebody can see and fix,
# instead of a loop that burns CPU on a machine a customer paid for.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=CENTURION_HOME=%h/.centurion
# Prefer the Centurion venv when present so `python -m centurion_cli.remote_bridge` resolves.
Environment=PATH=%h/.centurion/Centurion-AI-OS/venv/bin:%h/.centurion/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Override with the Centurion interpreter if install scripts detect one.
# Environment=CENTURION_REMOTE_PYTHON=%h/.centurion/Centurion-AI-OS/venv/bin/python
# A restart is not a stop: `systemctl --user restart` stops only what THIS unit
# owns, so a leftover process from an older install keeps port 9119 and every
# new start dies with EADDRINUSE. This releases the port, whoever holds it,
# BEFORE the service starts — and fails loudly rather than looping if it cannot.
ExecStartPre=/usr/libexec/centurion/centurion-free-port.sh 9119
ExecStart=/usr/bin/centurion-remote serve --name "Sovereign AI Brain"
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# CENTURION_HOME plus common tool workdirs. Install scripts append TERMINAL_CWD.
ReadWritePaths=%h/.centurion %h/.centurion/profiles %h/.cache %t
# Allow reading the Centurion checkout / venv under the home tree.
ReadOnlyPaths=%h/.local

[Install]
WantedBy=default.target
