[Unit]
Description=Centurion encrypted iPhone service (away-from-home TCP 9119)
Documentation=https://github.com/NousResearch/Centurion-AI-OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CENTURION_HOME=%h/.centurion
# Prefer the Centurion venv when present so `python -m centurion_cli.remote_bridge` resolves.
Environment=PATH=%h/.centurion/Centurion-AI-OS/venv/bin:%h/.centurion/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Override with the Centurion interpreter if install scripts detect one.
# Environment=CENTURION_REMOTE_PYTHON=%h/.centurion/Centurion-AI-OS/venv/bin/python
ExecStart=/usr/bin/centurion-remote serve --name "Sovereign AI Brain"
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# CENTURION_HOME plus common tool workdirs. Install scripts append TERMINAL_CWD.
ReadWritePaths=%h/.centurion %h/.centurion/profiles %h/.cache %t
# Allow reading the Centurion checkout / venv under the home tree.
ReadOnlyPaths=%h/.local

[Install]
WantedBy=default.target
